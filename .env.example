# JobRadar environment variables.
# Copy this file to ".env" and fill in real values. Never commit .env.

# --- Database ---
# Set these to use MySQL. If MYSQL_HOST is unset, JobRadar uses a local SQLite
# file (jobradar.db) instead. (Advanced: set DATABASE_URL to any SQLAlchemy URL
# to override everything.)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=jobradar
# DATABASE_URL=

# --- Phase 2 (AI scoring + proposal drafting) ---
OPENAI_API_KEY=

# --- Phase 3 (LinkedIn email ingestion via IMAP) ---
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- LinkedIn (web) fetcher via Selenium (optional; enable "LinkedIn (web)" in Settings) ---
# Uses LinkedIn's PUBLIC guest job search — no login, no credentials. Needs Chrome
# installed. Scraping LinkedIn is against their ToS; personal low-volume use only.
LINKEDIN_SEARCH_KEYWORDS=developer
LINKEDIN_SEARCH_LOCATION=Pakistan
# Set to 1 to restrict to remote roles.
LINKEDIN_SEARCH_REMOTE=
LINKEDIN_MAX_JOBS=50
# Optional explicit path to chrome.exe if auto-detection fails.
# CHROME_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Wellfound (AngelList) fetcher via Selenium (optional; enable in Settings) ---
# Uses Wellfound's PUBLIC role search — no login. Needs Chrome installed (it also
# reuses CHROME_BINARY above). Scraping Wellfound is against their ToS; personal
# low-volume use only. Role slug as it appears in /role/r/<slug>.
WELLFOUND_ROLE=software-engineer
# Set to 0 to search all locations instead of remote-only.
WELLFOUND_REMOTE=1
WELLFOUND_MAX_JOBS=50

# --- SkipTheDrive / Jobgether / Underdog.io (on by default, no credentials) ---
# Newest N jobs pulled from SkipTheDrive's WordPress API each cycle (max 100).
SKIPTHEDRIVE_MAX_JOBS=50
# Keyword used for Jobgether's server-rendered search (one request per cycle).
JOBGETHER_KEYWORD=developer
JOBGETHER_MAX_JOBS=60
# Underdog.io's API caps a page at 20 jobs; pages fetched per cycle.
UNDERDOG_MAX_PAGES=3

# --- Built In (off by default — see README) ---
# builtin.com/jobs is blocked by their Cloudflare WAF and their public GraphQL
# job resolver currently errors on most pages, so this usually returns nothing.
BUILTIN_MAX_JOBS=40
BUILTIN_PAGE_SIZE=20
BUILTIN_MAX_ATTEMPTS=3

# --- Phase 4 (Telegram notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Access key (login gate) ---
# When set, every visitor must enter this key on a login screen before seeing
# anything. The session lasts 30 days (cookie). Changing the key logs everyone
# out. Leave empty to run without a login (open access).
JOBRADAR_ACCESS_KEY=
# For local test runs only: set to 1 to force-disable the login gate.
# JOBRADAR_DISABLE_AUTH=

# --- General ---
# Contact address advertised in the scraper User-Agent (polite scraping).
JOBRADAR_CONTACT=nadeemmkhan441@gmail.com

# Override the SQLite file location. Leave unset for local runs (defaults to
# ./jobradar.db). Docker sets this to /data/jobradar.db (a mounted volume).
# JOBRADAR_DB_PATH=

# Override the AI model (defaults to gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
